{
  "name": "meeting-detection",
  "version": "0.2.0",
  "description": "macOS meeting detection engine for Electron/Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayobamiu/meeting-detection.git"
  },
  "homepage": "https://github.com/Ayobamiu/meeting-detection",
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "meeting-detection.darwin-universal.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:universal": "napi build --platform --release --target aarch64-apple-darwin && napi build --platform --release --target x86_64-apple-darwin && lipo -create -output meeting-detection.darwin-universal.node meeting-detection.darwin-arm64.node meeting-detection.darwin-x64.node",
    "test": "node test/smoke.js",
    "test:rust": "cargo test",
    "watch": "node test.js",
    "prepublishOnly": "npm run build:universal && npm run test:rust && npm test"
  },
  "keywords": [
    "meeting",
    "detection",
    "zoom",
    "teams",
    "google-meet",
    "webex",
    "electron",
    "napi",
    "macos",
    "native-addon"
  ],
  "author": "Usman Ayobami",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0"
  },
  "napi": {
    "name": "meeting-detection",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "universal-apple-darwin"
      ]
    }
  }
}
